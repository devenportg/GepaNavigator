# Только для локальной демонстрации; перед любым развёртыванием замените секреты.
# Не используйте реальные медицинские данные в демонстрационной версии.
POSTGRES_PASSWORD=gepa_dev_password
JWT_SECRET=local-development-only-secret-change-before-deployment-2026
INTEGRATION_KEY=local-demo-integration-key-change-before-deployment-2026
# Демо-пользователи создаются только при явном включении.
SEED_DEMO=false

# YandexGPT выключен по умолчанию. Для подключения используйте секрет сервисного аккаунта
# в локальном, неотслеживаемом .env или secret manager; не вставляйте реальный ключ сюда.
YANDEXGPT_ENABLED=false
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=
YANDEXGPT_MODEL_VERSION=latest
YANDEXGPT_TIMEOUT_SECONDS=30
YANDEXGPT_MAX_TOKENS=1200
YANDEXGPT_TEMPERATURE=0.2

# Локальный backend без Docker: DATABASE_URL=sqlite:///./gepa.db
